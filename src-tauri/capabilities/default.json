{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum the Nyx window needs: its own commands, window controls for the custom title bar, file/folder pickers, notifications.",
  "windows": ["main"],
  "permissions": [
    "allow-list-torrents",
    "allow-add-magnet",
    "allow-add-torrent",
    "allow-inspect-torrent",
    "allow-torrent-action",
    "allow-set-priorities",
    "allow-set-torrent-options",
    "allow-set-torrent-limits",
    "allow-get-detail",
    "allow-get-magnet",
    "allow-move-in-queue",
    "allow-get-settings",
    "allow-set-settings",
    "allow-register-associations",
    "allow-unregister-associations",
    "allow-take-pending-args",
    "allow-get-status",
    "allow-get-queue-order",
    "allow-check-update",
    "allow-install-update",
    "allow-restart-app",
    "allow-rss-run-now",
    "allow-search",
    "allow-fetch-torrent-url",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "dialog:allow-open",
    "notification:default"
  ]
}
